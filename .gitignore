/target
**/target
Cargo.lock.bak
*.swp
*~

# The frozen upstream clone is regenerable from oracle/UPSTREAM.lock
oracle/upstream/

# Court observations are generated by the runner, never committed
courts/*/*/oracle/
courts/*/*/candidate/
courts/*/*/residual.json
courts/*/*/evidence.json

# VM build artifacts are regenerable from the build scripts, never committed
vm/images/
# the interactive demo VM (qcow2 + iso + served binary)
vm/demo/
.scratch/

# local GUI run logs
km-*.log
LOG.txt
